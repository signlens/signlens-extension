{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["src/**", "e2e/**", "scripts/**", "playwright.config.ts", "!e2e/fixtures"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error",
                "noControlCharactersInRegex": "error"
            },
            "style": {
                "noNonNullAssertion": "error"
            }
        }
    }
}
