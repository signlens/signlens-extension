{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "src/**",
            "e2e/**",
            "test/**",
            "scripts/**",
            "static/*.css",
            "playwright.config.ts",
            "playwright.screenshots.config.ts",
            "!test/fixtures"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140
    },
    "css": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error",
                "noControlCharactersInRegex": "error"
            },
            "style": {
                "noNonNullAssertion": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/**", "test/**", "scripts/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "usePlaywrightValidDescribeCallback": "off"
                    }
                }
            }
        }
    ]
}
