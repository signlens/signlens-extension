{
  "name": "signlens-extension",
  "version": "0.1.0",
  "private": true,
  "description": "SignLens for the browser: a Wallet Standard wallet without keys that explains every signing request and hands it unchanged to your own wallet",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:firefox": "npm run build && node scripts/build-firefox.ts",
    "package": "npm run build && node scripts/package.ts",
    "check": "biome check --error-on-warnings . && tsc -p tsconfig.json",
    "format": "biome format --write .",
    "test": "node --test --test-randomize --test-timeout=30000 --test-force-exit \"src/**/*.test.ts\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:record": "npm run build",
    "test:e2e:record": "node scripts/record-api.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2"
  }
}
